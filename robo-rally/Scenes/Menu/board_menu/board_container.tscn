[sub_resource type="GDScript" id="GDScript_ydcld"]
script/source = "extends Node2D
class_name CarouselConatianer

@export var panel_width: float = 500.0
@export var spacing_between: float = 100.0
@export var transition_speed: float = 8.0

var current_index: int = 0
var panels: Array[Node2D] = []
var target_offset: float = 0.0
var current_offset: float = 0.0

var carousel: Node2D
var left_button: Button
var right_button: Button
var select_button: Button

func _ready() -> void:
	carousel = get_node_or_null(\"Carousel\")
	if not carousel:
		push_error(\"Carousel node not found inside CarouselContainer.\")
		return

	# Collect all panels
	for child in carousel.get_children():
		if child is Node2D:
			panels.append(child)

	if panels.is_empty():
		push_warning(\"No panels found under Carousel.\")
		return

	# Space panels horizontally
	var spacing = panel_width + spacing_between
	for i in range(panels.size()):
		panels[i].position = Vector2(i * spacing, 0)

	# Get buttons
	var parent = get_parent()
	left_button = parent.get_node_or_null(\"left\")
	right_button = parent.get_node_or_null(\"right\")
	select_button = parent.get_node_or_null(\"select\")

	if left_button:
		left_button.pressed.connect(_on_left_pressed)
	if right_button:
		right_button.pressed.connect(_on_right_pressed)
	if select_button:
		select_button.pressed.connect(_on_select_pressed)
	else:
		push_warning(\"Select button not found! Check node path.\")

	_update_target()


func _process(delta: float) -> void:
	if not carousel:
		return
	current_offset = lerp(current_offset, target_offset, delta * transition_speed)
	carousel.position.x = -current_offset


func _on_left_pressed() -> void:
	if current_index > 0:
		current_index -= 1
		_update_target()


func _on_right_pressed() -> void:
	if current_index < panels.size() - 1:
		current_index += 1
		_update_target()


func _update_target() -> void:
	var spacing = panel_width + spacing_between
	var viewport_center = get_viewport_rect().size.x / 2.0

	# Center the current panel exactly
	target_offset = float(current_index * spacing) - viewport_center + panel_width / 2.0


func _on_select_pressed() -> void:
	if panels.size() > 0:
		print(\"Selected panel:\", current_index, \"→\", panels[current_index].name)
	get_tree().change_scene_to_file(\"res://Scenes/board.tscn\")
"

